# Label the database this local app is intended to use. This label does not
# change the target; verify DATABASE_URL points to the correct project.
DB_ENVIRONMENT=development

# Use the connection string for your development project, not production.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# JWT Secret for authentication tokens
# Generate a secure random string for production: openssl rand -base64 32
JWT_SECRET="your-secret-key-here-change-this-in-production"
